  "foods": [
    {
      "theme": "food",
      "title": "仙台牛タン",
      "kicker": "宮城・仙台",
      "body": "昭和二十三年起自仙台的炭火牛舌文化；定食常配麥飯與尾湯，各店部位與調味各有堅持。啟程東北前，先收下這口在地味道。",
      "source": {
        "label": "せんだい旅日和（仙台観光情報）",
